# ============================================================
# InvoicePlane-DockerX
# Example environment file
# Copy to .env and adjust values for your environment
# ============================================================

# ============================================================
# GENERAL
# ============================================================
TZ=UTC
PULL_POLICY=if_not_present
COMPOSE_PROJECT_NAME=invoiceplane-dockerx

# ============================================================
# INVOICEPLANE APP
# ============================================================
IP_CONTAINER_NAME=invoiceplane_app
IP_PORT=9055
IP_URL=http://localhost:9055
IP_LANGUAGE=english

# ============================================================
# IMAGE / BUILD
# ============================================================
IP_IMAGE=ghcr.io/mrcee/invoiceplane-dockerx
IP_VERSION=1.7.1
PHP_VERSION=8.4
IP_SOURCE=https://github.com/InvoicePlane/InvoicePlane/releases/download

# ============================================================
# INVOICEPLANE RUNTIME / IPCONFIG
# ============================================================
ENABLE_DEBUG=false
REMOVE_INDEXPHP=true

# Fresh install defaults
# These are expected to change during setup/finalization.
DISABLE_SETUP=false
SETUP_COMPLETED=false

SESS_EXPIRATION=7200
SESS_MATCH_IP=0

ENABLE_INVOICE_DELETION=false
DISABLE_READ_ONLY=false

# Encryption settings
# Leave blank in .env.example.
# The finalizer/setup flow will populate these in .env when needed.
ENCRYPTION_CIPHER=
ENCRYPTION_KEY=

# ============================================================
# DATABASE
# ============================================================
MYSQL_CONTAINER_NAME=invoiceplane_db
MYSQL_VERSION=11.8.6
MYSQL_HOST=invoiceplane_db
MYSQL_PORT=3306

MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=invoiceplane
MYSQL_USER=invoiceplane
MYSQL_PASSWORD=change-me

# ============================================================
# OPTIONAL REVERSE PROXY / HTTPS BEHAVIOUR
# ============================================================
# TRUSTED_PROXIES=
# PROXY_MODE=false
# FORCE_HTTPS=false

# ============================================================
# HOST USER / PERMISSIONS
# System-managed — do not edit manually
# ============================================================
PUID=...
PGID=...
HOST_OS=...
HOST_WORKSPACE=...
MYSQL_UID=...
MYSQL_GID=...
STACK_PREPARED_BY=bin/up.sh
